{
  "expo": {
    "name": "Liga Softbol La Pascua",
    "slug": "liga-softbol-la-pascua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B4281"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ligalapascua.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B4281"
      },
      "icon": "./assets/images/icon.png",
      "package": "com.ligalapascua.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Liga Softbol La Pascua",
      "shortName": "Softbol La Pascua",
      "lang": "es",
      "backgroundColor": "#0B4281",
      "themeColor": "#0B4281"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    },
    "owner": "ligalapascua"
  }
}
